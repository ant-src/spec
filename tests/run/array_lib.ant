// The Array namespace (section 11).
func main(): void {
  var xs = [3, 1, 2]
  print(Array.sort(xs))
  print(xs)
  print(Array.sortBy(["bb", "a", "cc"], { String.length(x) }))
  print(Array.sortWith([3, 1, 2], func(a: int, b: int): int { b - a }))
  print(Array.reverse([1, 2, 3]))
  print(Array.slice([1, 2, 3, 4], 1, 3))
  print(Array.concat([1], [2, 3]))
  print(Array.reduce([1, 2, 3], 0, func(a: int, x: int): int { a + x }))
  print(Array.find([1, 2, 3], { x > 1 }))
  print(Array.find([1], { x > 5 }))
  print(Array.some([1, 2], { x == 2 }))
  print(Array.every([1, 2], { x > 0 }))
  print(Array.contains([1, 2], 2))
  print(Array.indexOf(["a", "b"], "b"))
  print(Array.indexOf(["a"], "z"))
  print(Array.entries(["x", "y"]))
  print(Array.range(0, 3))
  print(Array.range(3, 0))
  print(Array.filled(2, "z"))
  print(Array.flatten([[1], [2, 3], []]))
  print(Array.sum([1, 2, 3]))
  print(Array.sum([1.5, 2.5]))
  var e: Array[int] = []
  print(Array.sum(e))
  print(Array.get(xs, 10))
  print(Array.get(xs, 0))
  print(Array.pop(e))
  var ys = [1]
  print(Array.pop(ys))
  print(ys)
  print(Array.isEmpty(ys))
  print(Array.same(xs, xs))
  print(Array.same(xs, [3, 1, 2]))
  print(Array.length([...xs, ...xs]))
  print(Array.map([1, 2], { x * x }))
  print(Array.filter([1, 2, 3, 4], { x % 2 == 0 }))
  xs[0] = 9
  print(xs)
  Array.push(xs, 4)
  print(Array.length(xs))
}

// ---- expected
// out: [1, 2, 3]
// out: [3, 1, 2]
// out: ["a", "bb", "cc"]
// out: [3, 2, 1]
// out: [3, 2, 1]
// out: [2, 3]
// out: [1, 2, 3]
// out: 6
// out: 2
// out: null
// out: true
// out: true
// out: true
// out: 1
// out: null
// out: [Indexed{ index: 0, value: "x" }, Indexed{ index: 1, value: "y" }]
// out: [0, 1, 2]
// out: []
// out: ["z", "z"]
// out: [1, 2, 3]
// out: 6
// out: 4.0
// out: null
// out: null
// out: 3
// out: null
// out: 1
// out: []
// out: true
// out: true
// out: false
// out: 6
// out: [1, 4]
// out: [2, 4]
// out: [9, 1, 2]
// out: 4
