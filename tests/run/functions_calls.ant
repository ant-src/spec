// Calls: defaults, named arguments, lambdas of zero or one argument, closures, mutual recursion (section 6).
func connect(host: string, port: int = 443, tls: bool = true): string { `${host}:${port}:${tls}` }

func counter(): func(): int {
  var n = 0
  func(): int { n += 1; n }
}

func isEven(n: int): bool { if n == 0 { true } else { isOdd(n - 1) } }
func isOdd(n: int): bool { if n == 0 { false } else { isEven(n - 1) } }

func main(): void {
  print(connect("h"))
  print(connect("h", 8080))
  print(connect("h", tls: false))
  print(connect(port: 80, host: "x"))
  var next = counter()
  print(next())
  print(next())
  var other = counter()
  print(other())
  var double: func(int): int = { x * 2 }
  print(double(21))
  var thunk: func(): int = { 7 }
  print(thunk())
  print(isEven(10))
  var apply = func(f: func(int): int, v: int): int { f(v) }
  print(apply(double, 5))
  print(apply({ x + 1 }, 5))
  var noop: func(): void = {}
  print(noop())
}

// ---- expected
// out: h:443:true
// out: h:8080:true
// out: h:443:false
// out: x:80:true
// out: 1
// out: 2
// out: 1
// out: 42
// out: 7
// out: true
// out: 10
// out: 6
// out: void
