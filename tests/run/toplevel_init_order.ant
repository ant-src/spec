// Top-level initializers run in source order; functions and types are hoisted (section 10).
var a = compute()
var b = a + 1
var c: Later = Later{ n: b }

func compute(): int { print("init a"); 41 }

type Later = { n: int }

func main(): void {
  print(b)
  print(c)
}

// ---- expected
// out: init a
// out: 42
// out: Later{ n: 42 }
