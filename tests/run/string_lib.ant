// The String namespace: code points, bytes, parsing (section 11).
func main(): void {
  print(String.length("héllo"))
  print(String.slice("héllo", 1, 3))
  print(String.concat(["a", "b", "c"]))
  print(String.split("a,b,,c", ","))
  print(String.join(["x", "y"], "-"))
  print(String.repeat("ab", 3))
  print(String.trim("  pad  "))
  print(String.contains("hello", "ell"))
  print(String.startsWith("hello", "he"))
  print(String.endsWith("hello", "lo"))
  print(String.indexOf("héllo", "l"))
  print(String.indexOf("abc", "z"))
  print(String.replace("a-b-c", "-", "+"))
  print(String.toUpper("abc"))
  print(String.toLower("ABC"))
  print(String.chars("héy"))
  print(String.toBytes("hé"))
  print(String.fromBytes([byte(104), byte(105)]))
  print(String.fromBytes([byte(255)]))
  print(String.toCodePoints("hé"))
  print(String.fromCodePoints([104, 233]))
  print(String.fromCodePoints([1114112]))
  print(String.toInt("-42"))
  print(String.toInt("4x"))
  print(String.toFloat("2.5"))
  print(String.toFloat("abc"))
  print(String.from(1.0))
  print("a" + "b")
  print("a" < "b")
  print(String.isEmpty(""))
  print("é" == "é")
}

// ---- expected
// out: 5
// out: él
// out: abc
// out: ["a", "b", "", "c"]
// out: x-y
// out: ababab
// out: pad
// out: true
// out: true
// out: true
// out: 2
// out: null
// out: a+b+c
// out: ABC
// out: abc
// out: ["h", "é", "y"]
// out: [104, 195, 169]
// out: hi
// out: null
// out: [104, 233]
// out: hé
// out: null
// out: -42
// out: null
// out: 2.5
// out: null
// out: 1.0
// out: ab
// out: true
// out: true
// out: true
