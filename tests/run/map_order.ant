// Maps keep insertion order: literals, iteration, keys, rendering, replacement, removal (section 4, Arrays and maps).
func main(): void {
  var m = Map{ c: 3, a: 1, b: 2 }
  print(m)
  print(Map.keys(m))
  m["a"] = 10
  m["d"] = 4
  print(m)
  Map.remove(m, "c")
  m["c"] = 30
  print(m)
  for { key, value } in m {
    if key == "a" { m["e"] = 5 }
    print(`${key}=${value}`)
  }
  print(Map.merge(Map{ x: 1, y: 2 }, Map{ z: 3, x: 9 }))
}

// ---- expected
// out: Map{ "c": 3, "a": 1, "b": 2 }
// out: ["c", "a", "b"]
// out: Map{ "c": 3, "a": 10, "b": 2, "d": 4 }
// out: Map{ "a": 10, "b": 2, "d": 4, "c": 30 }
// out: a=10
// out: b=2
// out: d=4
// out: c=30
// out: e=5
// out: Map{ "x": 9, "y": 2, "z": 3 }
// exit: 0
