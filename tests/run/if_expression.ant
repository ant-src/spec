// if as an expression: branch values, the implicit void else (section 5).
func sign(n: int): string { if n < 0 { "negative" } else if n == 0 { "zero" } else { "positive" } }

func main(): void {
  print(sign(-5))
  print(sign(0))
  print(sign(9))
  var v = if true { 1 } else { 2 }
  print(v)
  var w = if false { 1 }
  print(w)
  var n = 0
  var u = if true { n = 1 } else { n = 2 }
  print(u)
  print(n)
  var t = if true { n += 1; n * 10 } else { 0 }
  print(t)
}

// ---- expected
// out: negative
// out: zero
// out: positive
// out: 1
// out: void
// out: void
// out: 1
// out: 20
