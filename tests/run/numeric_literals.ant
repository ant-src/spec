// Integer and float literals, integer division and remainder (sections 2, 5, 12).
func main(): void {
  print(0xFF)
  print(0b1010)
  print(1_000_000)
  print(1e3)
  print(2.5e-1)
  print(10 / 3)
  print(-7 / 2)
  print(-7 % 2)
  print(7 % -2)
  print(7.0 / 2.0)
  print(2 * 3 + 4)
  print(2 + 3 * 4)
  print(-2 * -3)
  print(7.5 % 2.0)
}

// ---- expected
// out: 255
// out: 10
// out: 1000000
// out: 1000.0
// out: 0.25
// out: 3
// out: -3
// out: -1
// out: 1
// out: 3.5
// out: 10
// out: 14
// out: 6
// out: 1.5
