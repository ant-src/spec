// Helper module for the functions-on-types test. Not a test itself.
export type Point = { x: float64, y: float64 }

export func Point.origin(): Point { Point{ x: 0.0, y: 0.0 } }

export func Point.distance(a: Point, b: Point): float64 {
  Math.sqrt((a.x - b.x) * (a.x - b.x) + (a.y - b.y) * (a.y - b.y))
}

export func Point.norm(p: Point): float64 { p | Point.distance(Point.origin()) }

func Point.secret(p: Point): string { "private" }

export func Point.describe(p: Point): string { `${p.x},${p.y} (${Point.secret(p)})` }

export type Circle = { radius: float64 }
export type Rect = { width: float64, height: float64 }
export type Shape = Circle | Rect

export func Shape.area(s: Shape): float64 {
  if s is Circle { 3.0 * s.radius * s.radius } else { s.width * s.height }
}

export type UserId = string

export func UserId.parse(s: string): UserId | null {
  if String.startsWith(s, "u-") { UserId(s) } else { null }
}

export type Box[T] = { value: T }

export func Box.map[T, U](b: Box[T], f: func(T): U): Box[U] { Box{ value: f(b.value) } }

export type Tree = { value: int, children: Array[Tree] }

export func Tree.size(t: Tree): int { 1 + (Array.sum(Array.map(t.children, Tree.size)) ?? 0) }

export func Tree.leaf(value: int): Tree { Tree{ value: value, children: [] } }
