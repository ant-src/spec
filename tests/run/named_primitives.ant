// Named primitive types: construction, unwrapping, operators, map keys, the constructor as a function (section 4).
type UserId = string
type AccountId = string
type Meters = float64

func main(): void {
  var id = UserId("u-1")
  print(string(id))
  print(id == UserId("u-1"))
  var v: UserId | string = id
  print(v is UserId)
  v = "plain"
  print(v is UserId)
  var w: UserId | AccountId = AccountId("a-1")
  print(w is AccountId)
  var d = Meters(3.0) * Meters(2.0)
  print(d)
  print(Meters(1.0) < Meters(2.0))
  print(float64(d) + 1.0)
  var ids = Array.map(["a", "b"], UserId)
  print(ids)
  var m: Map[UserId, int] = Map{}
  m[UserId("k")] = 1
  print(m[UserId("k")])
  print(m[UserId("x")])
  var f: (func(string): UserId) | string = UserId
  print(f is func)
}

// ---- expected
// out: u-1
// out: true
// out: true
// out: false
// out: true
// out: Meters(6.0)
// out: true
// out: 7.0
// out: [UserId("a"), UserId("b")]
// out: 1
// out: null
// out: true
