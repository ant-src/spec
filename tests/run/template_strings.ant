// Template strings: interpolation, nesting, multi-line, escapes (section 2).
type P = { x: int }

func main(): void {
  var p = P{ x: 3 }
  print(`a ${p.x + 1} b`)
  print(`${[1, 2]} ${P{ x: 1 }}`)
  print(`${if p.x > 2 { "big" } else { "small" }}`)
  var lines = `one
two`
  print(lines)
  print(`\${x} \``)
  print(`${`inner ${p.x}`}!`)
}

// ---- expected
// out: a 4 b
// out: [1, 2] P{ x: 1 }
// out: big
// out: one
// out: two
// out: ${x} `
// out: inner 3!
