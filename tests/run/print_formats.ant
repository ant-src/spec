// String.from: the rendering of every kind of value (section 11, String).
type Point = { x: float64, y: float64 }
type Empty = {}
type UserId = string

func main(): void {
  print(42)
  print(-7)
  print(3.5)
  print(2.0)
  print(1.0 / 0.0)
  print(-1.0 / 0.0)
  print(0.1 + 0.2)
  print("plain")
  print(true)
  print(null)
  print(void)
  print([1, 2, 3])
  print(["a", "b"])
  print(Map{ a: 1 })
  print(Point{ x: 1.0, y: 2.5 })
  print(UserId("u-1"))
  var f: func(int): int = { x * 2 }
  print(f)
  print(UserId)
  print(Mutex.new())
  print(`${1 + 1} and ${"s"}`)
  var nested: Array[Array[int]] = [[1], []]
  print(nested)
  var empty: Array[int] = []
  print(empty)
  var emptyMap: Map[string, int] = Map{}
  print(emptyMap)
  print(Empty{})
  print(Point{ y: 2.0, x: 1.0 })
}

// ---- expected
// out: 42
// out: -7
// out: 3.5
// out: 2.0
// out: Infinity
// out: -Infinity
// out: 0.30000000000000004
// out: plain
// out: true
// out: null
// out: void
// out: [1, 2, 3]
// out: ["a", "b"]
// out: Map{ "a": 1 }
// out: Point{ x: 1.0, y: 2.5 }
// out: UserId("u-1")
// out: func
// out: UserId
// out: Mutex
// out: 2 and s
// out: [[1], []]
// out: []
// out: Map{}
// out: Empty{}
// out: Point{ x: 1.0, y: 2.0 }
