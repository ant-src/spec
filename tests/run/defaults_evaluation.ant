// Defaults evaluate in the callee's scope, in parameter order, after the arguments (section 12).
var log: Array[string] = []

func trace(s: string): int { Array.push(log, s); 1 }

func f(a: int = trace("a"), b: int = trace("b")): int { a + b }

func main(): void {
  print(f(b: 5))
  print(log)
  print(f())
  print(log)
  print(f(2, 3))
  print(Array.length(log))
}

// ---- expected
// out: 6
// out: ["a"]
// out: 2
// out: ["a", "a", "b"]
// out: 5
// out: 3
