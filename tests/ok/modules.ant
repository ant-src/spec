export type Point2 = { x: float64, y: float64 }
export var origin = Point2{ x: 0.0, y: 0.0 }
export func distance2(a: Point2, b: Point2): float64 {
  Math.sqrt((a.x - b.x) * (a.x - b.x) + (a.y - b.y) * (a.y - b.y))
}

