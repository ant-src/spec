// A bare return leaves a go or defer block; a lambda inside one is a new boundary and may return a value.

func main(): void {
  var done = false
  go {
    if done { return }
    var pick = { x ?? return 0 }
    print(pick(null))
  }
  defer {
    if done { return }
    print(`${done ?? return}`)
  }
  done = true
}
